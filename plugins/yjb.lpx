#!name = 养鸡宝净化
#!desc = 养鸡宝去广告、VIP解锁
#!author = Custom
#!loon_version = 3.5.2(996)
#!date = 2026-10-23

[mitm]
hostname = *.yangjibao.com

[rewrite]
^https?:\/\/.*yangjibao.com\/unify_ad url script-response-body https://xxx/unify_ad.js, requires-body=true, tag=养鸡宝-清除广告
^https?:\/\/.*yangjibao\.com\/(.*\/account|vip_info) url script-response-body https://xxx/vip.js, requires-body=true, tag=养鸡宝-VIP解锁
