#!name=微博净化
#!desc=微博APP信息流、广告净化
#!author=ddgksf2013
#!homepage =https://ddgksf2013.top
#!date=2026-10-30 17:10
#!loon_version=3.5.2(996)
#!icon=https://resource.wuyra.com/Icon/App_icon/120px/Weibo.png
#!openUrl=https://apps.apple.com/app/id350962115
#!system=iOS,iPadOS


[Script]

# 微博配置接口读写
http-request ^https://api\.weibo\.cn/__qx_weibo_settings__/(?:api/config)?(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, timeout=60, tag=微博配置读取

# 微博配置保存重置
http-request ^https://api\.weibo\.cn/__qx_weibo_settings__/api/(?:save|reset)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博配置保存重置

# 微博核心信息流接口去广告
http-response ^https?://api\.weibo\.cn(?:/2/statuses/container_timeline_hot|/2/guest/container_timeline_hot|/2/statuses/container_timeline_unread|/2/statuses/container_timeline|/2/live/media_homelist|/2/remind/hometab_dot|/2/remind/unread_count|/2/statuses/container_detail|/2/statuses/container_detail_comment|/2/comments/build_comments|/2/search/finder|/2/search/container_timeline|/2/search/container_discover|/2/!/was/finder/searchbarchange|/2/cardlist|/2/searchall|/2/profile/me|/2/profile/container_timeline|/2/video/flow_stream|/2/video/flow_stream_cache|/2/push/daily|/2/push/active|/2/guest/push_active|/2/groups/allgroups/v2|/2/client/abserver_list|/2/checkin/show|/2/video/remind_info|/2/video/home_channels)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博信息流&搜索&个人页去广告

# 微博预加载广告清洗
http-response ^https?://bootpreload\.uve\.weibo\.com(?:/v2/ad/preload)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博预加载广告过滤

# 微博实时广告清洗
http-response ^https?://bootrealtime\.uve\.weibo\.com(?:/v3/ad/realtime)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博实时广告过滤

# 微博拉取广告lua接口清洗
http-response ^https?://wbapp\.uve\.weibo\.com(?:/wbapplua/wbpullad\.lua)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博广告拉取接口过滤

[MITM]
hostname = api.weibo.cn, bootpreload.uve.weibo.com, wbapp.uve.weibo.com
