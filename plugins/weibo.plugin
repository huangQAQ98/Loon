#!name=微博净化
#!desc=微博APP信息流、广告净化
#!author=ddgksf2013
#!date=2026-10-14
#!loon_version=3.5.2(996)
#!icon=https://raw.githubusercontent.com/Toperlock/Quantumult/main/icon/Weibo/Weibo.png
#!openUrl=https://apps.apple.com/app/id350962115
#!system=iOS,iPadOS

[Script]
# 读取配置 
http-response ^https?:\/\/api\.weibo\.cn\/__qx_weibo_settings__\/(?:api\/config)?(?=[?#]|$)$ script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=微博_读取配置

# 保存/重置配置 
http-response ^https?:\/\/api\.weibo\.cn\/__qx_weibo_settings__\/api\/(?:save|reset)(?=[?#]|$)$ script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=微博_保存重置配置

# 信息流、评论、热搜、推荐接口 
http-response ^https?:\/\/api\.weibo\.cn(?:\/2\/statuses\/container_timeline_hot|\/2\/guest\/container_timeline_hot|\/2\/statuses\/container_timeline_unread|\/2\/statuses\/container_timeline|\/2\/live\/media_homelist|\/2\/remind\/hometab_dot|\/2\/remind\/unread_count|\/2\/statuses\/container_detail|\/2\/statuses\/container_detail_comment|\/2\/comments\/build_comments|\/2\/search\/finder|\/2\/search\/container_timeline|\/2\/search\/container_discover|\/2\/!\/was\/finder\/searchbarchange|\/2\/cardlist|\/2\/profile\/me|\/2\/video\/flow_stream|\/2\/video\/flow_stream_cache|\/2\/push\/daily|\/2\/push\/active|\/2\/guest\/push_active|\/2\/groups\/allgroups\/v2|\/2\/client\/abserver_list|\/2\/checkin\/show|\/2\/video\/remind_info|\/2\/video\/home_channels)(?=[?#]|$)$ script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=微博_信息流净化

# 开屏预加载广告
http-response ^https?:\/\/bootpreload\.uve\.weibo\.com(?:\/v2\/ad\/preload)(?=[?#]|$)$ script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=微博_开屏预加载广告

# wbpullad广告接口
http-response ^https?:\/\/wbapp\.uve\.weibo\.com(?:\/wbapplua\/wbpullad\.lua)(?=[?#]|$)$ script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=微博_广告拉取接口

[MITM]
hostname = api.weibo.cn, bootpreload.uve.weibo.com, wbapp.uve.weibo.com
