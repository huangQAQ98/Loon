[MITM]
hostname = api.weibo.cn, bootpreload.uve.weibo.com, wbapp.uve.weibo.com

[Rewrite]
http-response ^https:\/\/api\.weibo\.cn\/__qx_weibo_settings__\/(?:api/config)?(?=[?#]|$) url script-echo-response https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=NBPro去广告
http-response ^https:\/\/api\.weibo\.cn\/__qx_weibo_settings__\/api\/(?:save|reset)(?=[?#]|$) url script-analyze-echo-response https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=NBPro去广告
http-response ^https?:\/\/api\.weibo\.cn(?:\/2\/statuses\/container_timeline_hot|\/2\/guest\/container_timeline_hot|\/2\/statuses\/container_timeline_unread|\/2\/statuses\/container_timeline|\/2\/live\/media_homelist|\/2\/remind\/hometab_dot|\/2\/remind\/unread_count|\/2\/statuses\/container_detail|\/2\/statuses\/container_detail_comment|\/2\/comments\/build_comments|\/2\/search\/finder|\/2\/search\/container_timeline|\/2\/search\/container_discover|\/2\/!\/was\/finder\/searchbarchange|\/2\/cardlist|\/2\/profile\/me|\/2\/video\/flow_stream|\/2\/video\/flow_stream_cache|\/2\/push\/daily|\/2\/push\/active|\/2\/guest\/push_active|\/2\/groups\/allgroups\/v2|\/2\/client\/abserver_list|\/2\/checkin\/show|\/2\/video\/remind_info|\/2\/video\/home_channels)(?=[?#]|$) url script-response-body https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=NBPro去广告
http-response ^https?:\/\/bootpreload\.uve\.weibo\.com(?:\/v2\/ad\/preload)(?=[?#]|$) url script-response-body https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=NBPro去广告
http-response ^https?:\/\/wbapp\.uve\.weibo\.com(?:\/wbapplua\/wbpullad\.lua)(?=[?#]|$) url script-response-body https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, tag=NBPro去广告
