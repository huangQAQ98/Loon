#!name=酷安
#!desc=酷安去广告,应用净化
#!openUrl=https://apps.apple.com/app/id1422581869
#!author=自有[https://github.com/huangQAQ98/Loon],ddgksf2013[https://ddgksf2013.top]
#!homepage =https://github.com/huangQAQ98/Loon
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1010.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.2(996)
#!date = 2026-10-1

[Argument]
kuan_enable = switch,true,false,tag=酷安-脚本开关

[Rewrite]
# > 酷安_屏蔽热词@ddgksf2013
# hostname = api.coolapk.com, www.coolapk.com
^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-200


[Script]
# > 酷安_开屏广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/main\/init script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_推广广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/dataList script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_首页广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/main\/indexV8 script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_酷品页推广@ddgksf2013
http-response https://api.coolapk.com/v6/page/dataList\?.*title=%E9%85 script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_页面数据过滤 = type=
http-response, pattern=^https://api\.coolapk\.com/v6/page/dataList, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/NSRingo/Loon-Script/master/Scripts/JSONResponseJQ.js, argument=if (.data | length > 0) then .data |= map(select((.title? != "酷安热搜") and (.entityTemplate? != "imageScaleCard") and (.entityTemplate? != "sponsorCard"))) else . end

# > 酷安
# hostname = api.coolapk.com, www.coolapk.com
http-response ^https?:\/\/api\.coolapk\.com\/v6\/feed\/(detail|replyList)\? script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js, requires-body=true, timeout=60, tag=酷安, enable={kuan_enable}
http-response ^https?:\/\/api\.coolapk\.com\/v6\/main\/(dataList|indexV8|init) script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js, requires-body=true, timeout=60, tag=酷安, enable={kuan_enable}
http-response ^https?:\/\/api\.coolapk\.com\/v6\/page\/dataList\? script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js, requires-body=true, timeout=60, tag=酷安, enable={kuan_enable}
http-request ^https:\/\/www\.coolapk\.com\/link.* script-path=https://raw.githubusercontent.com/VenenoSix24/Ivy-Script/refs/heads/main/Loon/script/Coolapk_Redirect.js, requires-body=false, timeout=10, tag=酷安URL重定向, enable={kuan_enable}


[MITM]
hostname = api.coolapk.com,  www.coolapk.com, 
