#!name=酷安
#!desc=酷安去广告,应用净化
#!openUrl=https://apps.apple.com/app/id1422581869
#!author=自有[https://github.com/huangQAQ98/Loon],ddgksf2013[https://ddgksf2013.top]
#!homepage =https://github.com/huangQAQ98/Loon
#!icon=https://github.com/huangQAQ98/IconLibrary/blob/844b1391aa6b32e3571826484eec965d41fa8ed2/App/CoolApk.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.2(996)
#!date = 2026-10-1



[Rewrite]
# > 酷安_屏蔽热词@ddgksf2013
^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-200

[Script]
# > 酷安_开屏广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/main\/init script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_推广广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/dataList script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_首页广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/main\/indexV8 script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_评论广告@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/feed\/replyList script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_商品推广@ddgksf2013
http-response ^https?:\/\/api.coolapk.com\/v6\/feed\/detail script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 酷安_酷品页推广@ddgksf2013
http-response https://api.coolapk.com/v6/page/dataList\?.*title=%E9%85 script-path=https://github.com/ddgksf2013/Scripts/raw/master/coolapk.js, requires-body=true, timeout=60, tag=coolapk

# > 帖子详情页：清理赞助卡片、商品卡片
http-response https://api.coolapk.com\/v6\/feed\/detail\? script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60

# > 评论列表过滤无效评论
http-response https://api.coolapk.com\/v6\/feed\/replyList url script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60

# > 首页移除广告、精选配件
http-response https://api.coolapk.com\/v6\/main\/dataList url script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60

# > 过滤话题热议及指定广告
http-response https://api.coolapk.com\/v6\/page\/dataList url script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60

# > 过滤值得买、红包卡片
http-response https://api.coolapk.com\/v6\/main\/indexV8 url script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60

# > 首页初始化广告卡片删除
http-response https://api.coolapk.com\/v6\/main\/init url script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60

# > 个人主页卡片配置过滤
http-response https://api.coolapk.com\/v6\/account\/loadConfig\?key=my_page_card_config url script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/coolapk.js, requires-body=true,timeout=60
[MITM]
hostname = api.coolapk.com,  www.coolapk.com
