hlw = switch,false,true,tag=黑料网,desc=关闭开关将不对黑料网生效
baoyu = switch, false, tag = 鲍鱼盒子, desc = 关闭开关将不对鲍鱼盒子生效
Authorization = input, "eb8fbd7caca26d2b8147e59340b78d60", tag = Authorization, desc = 鲍鱼盒子token(必填)
