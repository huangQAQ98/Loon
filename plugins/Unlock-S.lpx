const header = $request.headers;

const authorization = $argument?.Authorization;

if (!authorization) {
    console.log("参数缺失信息：");
    if (!authorization) console.log("❌ Authorization 参数缺失");

    $notification.post(
        "🧧遇到问题",
        "参数缺失",
        "请在插件内填入完整的会员数据"
    );

    $done({});
    return;
}

header["authorization"] = "Bearer " + authorization;

console.log("✅ 🧧已解锁 🎉");

$done({ headers: header });



