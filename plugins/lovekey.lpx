[Script]
# 聊天 / 开场白 / 超级对话（覆盖 *-ow-msg / *-stream-msg / stream_super_msg）
http-request ^https://sea\.api\.lovekeyboard\.com/\S*(?:-(?:ow|stream)-msg|stream_super_msg) script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/lovekey.js, timeout=60, tag=lovekey

http-response ^https://sea\.api\.lovekeyboard\.com/v2/account script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/lovekey.js, requires-body=true, timeout=60, tag=lovekey

[MITM]
hostname = sea.api.lovekeyboard.com
