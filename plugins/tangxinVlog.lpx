[Script]
http-request ^https?:\/\/((?:[a-z]+\.)?txh\d+\.com)\/(h5\/(?:user\/info|system\/info|movie\/(?:detail|block|search))) script-path=https://txscript.pages.dev/tx/loon.js, tag=糖心解锁, requires-body=true

[Mitm]
hostname = *.txh066.com, *.txh067.com, *.txh068.com, *.txh069.com, *.txh087.com, txh066.com, txh067.com, txh068.com, txh069.com, txh087.com