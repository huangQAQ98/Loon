#!name=虎扑去广告【jq原生版｜参照酷安写法】
#!desc=虎扑APP去广告｜Loon原生 response-body-json-jq 修改JSON，不整体mock
#!author=热心群友
#!loon_version=3.2.0
#!system=iOS,iPadOS
#!tag=虎扑,去广告

[Rule]
DOMAIN-SUFFIX,goblin.hupu.com,DIRECT
DOMAIN-SUFFIX,games.mobileapi.hupu.com,DIRECT

[Rewrite]
# goblin 广告接口 清空ads广告数组
^https:\/\/goblin\.hupu\.com\/\d+\/[\d.]+\/interfaceAd\/getOther response-body-json-jq '.ads = []' , tag=虎扑goblin广告

# goblin批量广告接口
^https:\/\/goblin\.hupu\.com\/.*\/interfaceAd\/getOther\/batch response-body-json-jq '.ads = []' , tag=虎扑批量广告

# banner横幅广告，清空list数组
^https:\/\/games\.mobileapi\.hupu\.com\/.*\/banner\/getLocation response-body-json-jq '.data.list = []' , tag=虎扑banner横幅

# 搜索热搜广告清空
^https:\/\/games\.mobileapi\.hupu\.com\/.*\/search\/v2\/(hintkeylist|hotkeylist) response-body-json-jq '.data.list = []' , tag=虎扑搜索热搜

# 广告埋点上报（可选，直接reject，不想拦截可以删掉这一行）
# ^https:\/\/games\.mobileapi\.hupu\.com\/.*\/interfaceAdMonitor reject-dict , tag=虎扑广告上报

[Mitm]
hostname = goblin.hupu.com,games.mobileapi.hupu.com
