[Rule]
DOMAIN-SUFFIX,goblin.hupu.com,DIRECT

[Rewrite]
^https?:\/\/goblin\.hupu\.com\/\d+\/[\d.]+\/interfaceAd\/getOther mock-response-body data-type=json data="{\"ad_code\":-41,\"show_type\":0,\"ads\":[]}" status-code=200, tag=虎扑广告接口mock

[Mitm]
hostname = goblin.hupu.com
