[Plugin]
#!name = 最美壁纸
#!desc = 解锁会员，移除悬浮广告、横幅广告、轮播图广告、精简我的页面
#!openUrl = https://apps.apple.com/app/id1003706884
#!author =西八[https://github.com/huangQAQ98/Loon]
#!tag = 解锁vip
#!homepage =https://github.com/huangQAQ98/Loon
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iWallBiZhi.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.2(996)
#!date = 2026-10-11

[Rewrite]
#拦截热搜接口
^https:\/\/api\.fzxhmy\.com\/seek\/trendingword\? reject-dict
#拦截热门铃声接口
^https:\/\/api\.fzxhmy\.com\/tone\/trending\? reject-dict

[Script]
#解锁最美壁纸会员
http-response ^https:\/\/api\.fzxhmy\.com\/(?:unique\/(?:backgrounds|landinginitialize|division\/material)|image\/fetch|avatar\/landing|background\/overview|member\/details|creator\/newcomers|np\/overview) script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/zuimeibizhi.js, requires-body=true, timeout=60, tag=解锁最美壁纸会员
#移除首页广告配置
http-response ^https:\/\/api\.fzxhmy\.com\/core\/initialize\? script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/core_initialize.js, requires-body=true, tag=移除首页广告配置

[MITM]
hostname = api.fzxhmy.com
