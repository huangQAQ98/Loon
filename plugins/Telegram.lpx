#!name=Telegram
#!desc=Telegram外部链接跳转，将tg的垃圾IP转移到好的IP上
#!author=恩秀[https://loonlab.103516.xyz/Plugin/],自有[https://github.com/huangQAQ98/Loon]
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png
#!openUrl=https://apps.apple.com/app/id686449807
#!tag=功能增强
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.2(1005)
#!homepage=https://github.com/huangQAQ98/Loon
#!date=2026-10-30 12:00

[Argument]
tgapp = select, "Telegram", "Swiftgram", "Nagram", "Turrit", "iMe", "Nicegram", "Lingogram", tag = 跳转至对应客户端


[Host]
# Fuck Telegram bad ips
91.108.56.100 = 91.108.56.147, use-in-proxy=true
91.108.56.101 = 91.108.56.147, use-in-proxy=true
91.108.56.104 = 91.108.56.147, use-in-proxy=true
91.108.56.107 = 91.108.56.147, use-in-proxy=true
91.108.56.109 = 91.108.56.147, use-in-proxy=true
91.108.56.110 = 91.108.56.147, use-in-proxy=true
91.108.56.113 = 91.108.56.147, use-in-proxy=true
91.108.56.120 = 91.108.56.147, use-in-proxy=true
91.108.56.125 = 91.108.56.147, use-in-proxy=true
91.108.56.126 = 91.108.56.147, use-in-proxy=true
91.108.56.128 = 91.108.56.147, use-in-proxy=true
91.108.56.134 = 91.108.56.147, use-in-proxy=true
91.108.56.138 = 91.108.56.147, use-in-proxy=true
91.108.56.143 = 91.108.56.147, use-in-proxy=true
91.108.56.145 = 91.108.56.147, use-in-proxy=true
91.108.56.156 = 91.108.56.147, use-in-proxy=true

[Rule]
DOMAIN-SUFFIX, nagram.app, PROXY
DOMAIN-SUFFIX, swiftgram.app, PROXY
DOMAIN-SUFFIX, iturrit.com, PROXY
DOMAIN-SUFFIX, imem.app, PROXY
DOMAIN-SUFFIX, nicegram.app, PROXY
DOMAIN-SUFFIX, nicegram.cloud, PROXY
DOMAIN-SUFFIX, intentchat.app, PROXY

[Rewrite]
# Telegram
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "Telegram" then redirect(307, "tg://resolve?domain=${urlMatch.2}")
# Swiftgram
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "Swiftgram" then redirect(307, "sg://resolve?domain=${urlMatch.2}")
# Nagram
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "Nagram" then redirect(307, "na://resolve?domain=${urlMatch.2}")
# Turrit
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "Turrit" then redirect(307, "turrit://resolve?domain=${urlMatch.2}")
# iMe
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "iMe" then redirect(307, "ime://resolve?domain=${urlMatch.2}")
# Nicegram
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "Nicegram" then redirect(307, "ng://resolve?domain=${urlMatch.2}")
# Lingogram
request if ${url} ~= /^(https?:\/\/)?(?:t\.me|telegram\.(?:me|dog))\/(.+)/ as urlMatch && ${tgapp} == "Lingogram" then redirect(307, "lingo://resolve?domain=${urlMatch.2}")

[Script]
response if ${url} ~= /^https?:\/\/(t\.me|telegram\.(me|dog))\/(.+)/i then script("https://loon.103516.xyz/Script/Telegram/Telegram.redirect.js", {${tgapp}}) with tag="[Telegram]t.me重定向", requires_body=false

[MitM]
hostname = t.me, telegram.me, telegram.dog
